# ---- MySQL ----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=your_user
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=crypto_signals
# All signal-bot components, including RetailBot v2, use MYSQL_DATABASE.

# ---- Binance ----
# Public market data endpoints do NOT require API keys.
# Only add keys later if you place orders / need higher rate limits.
BINANCE_API_KEY=your_api_key

# ---- Telegram (used in a later step, keep here for convenience) ----
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Set true only after confirming futures WS (fstream.binance.com) is
# reachable from your network -- some regions restrict Binance Futures.
ENABLE_FUTURES=True

# ---- Collector tuning ----
OI_POLL_INTERVAL_SECONDS=60
FUNDING_WRITE_INTERVAL_SECONDS=60

# ---- News + Economic Calendar (News AI Overlay strategy, Phase 1) ----
# CryptoPanic: crypto-specific news/sentiment. Free tier available:
#   https://cryptopanic.com/developers/api/
CRYPTOPANIC_API_KEY=your_cryptopanic_token
# Finnhub: macro economic calendar (CPI, FOMC, NFP, etc). Free tier available:
#   https://finnhub.io/register
FINNHUB_API_KEY=your_finnhub_key
NEWS_POLL_INTERVAL_SECONDS=120
ECON_CALENDAR_POLL_INTERVAL_SECONDS=3600
ECON_CALENDAR_MIN_IMPACT=medium

# ---- AI reasoning layer (News AI Overlay strategy, Phase 2) ----
# Anthropic API key -- https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-sonnet-5
NEWS_AI_POLL_INTERVAL_SECONDS=300
NEWS_AI_MIN_CONFIDENCE=75
NEWS_AI_MAX_EVENTS_PER_SYMBOL=15

# ---- Execution (News AI Overlay strategy, Phase 3) ----
NEWS_AI_EXECUTION_POLL_INTERVAL_SECONDS=60

# ---- Paper trading engine (run_paper_engine.py) ----
# Without this running, "Live Paper Trading" never evaluates on its own --
# it only ran on a manual "Evaluate Market Tick" click, on deploy, or
# after an ML run.
PAPER_ENGINE_POLL_INTERVAL_SECONDS=60
NEWS_AI_MAX_TRADES_PER_DAY=3
NEWS_AI_STOP_ATR_MULT=1.5


# ---- Smart Money Screener ----
# Universe: Binance spot pairs quoted in SYMBOLS_FILTER.
TIMEFRAME=1m
MIN_QUOTE_VOLUME_24H=1000000
# Optional CoinGecko market-cap floor. Set 0 to disable.
MIN_MARKET_CAP_USD=50000000
MARKET_CAP_PAGES=5
MARKET_CAP_REFRESH_MINUTES=30
# Quality gate: require at least two independent conditions.
REQUIRE_CONFLUENCE=true
MIN_SIGNAL_RVOL=5.0
MIN_SIGNAL_VELOCITY=3.0
MIN_QUALITY_SCORE=70
# HTF confirmation is evaluated only from already-closed 5m/15m candles.
HTF_TIMEFRAMES=5m,15m
HTF_EMA_FAST=9
HTF_EMA_SLOW=21
HTF_MIN_BARS=25
HTF_TIMEOUT_SEC=3
# A 1m anomaly cannot score 80+ unless HTF context is available.
MAX_QUALITY_WITHOUT_HTF=79
USE_TAKER_BUY_CONFIRMATION=true
RVOL_MULTIPLIER=7.0
VELOCITY_THRESHOLD=5.0
DIVERGENCE_MAX_PRICE_CHANGE=0.3
MAX_ALERTS_PER_HOUR=5
# Telegram delivery gate; MIN_QUALITY_SCORE above controls DB candidate detection only.
MIN_ALERT_QUALITY_SCORE=80
# Keep candidates fresh for up to 15 minutes while respecting the 5/hour delivery cap.
MAX_SIGNAL_AGE_SEC=900
# Weekly cleanup removes only EXPIRED rows older than this retention period.
EXPIRED_SIGNAL_RETENTION_DAYS=30
EXPIRED_SIGNAL_CLEANUP_INTERVAL_DAYS=7
MAX_ALERTS_PER_SYMBOL_PER_HOUR=1
ALERT_COOLDOWN_SEC=900

# --- Wallet Tracking (GeckoTerminal primary; optional Birdeye free-tier trade fallback) ---
# Optional: create a Birdeye Data Standard (free) API key to enable pair-trade fallback.
# Keep the account on the free plan; do not enable paid auto-renewal/overage.
BIRDEYE_API_KEY=
# Defaults below match config.py. If wallet_tracker_settings has a saved row,
# the dashboard's persisted MariaDB settings take precedence over these values.
WALLET_TRACKER_ENABLED=true
WALLET_TRACKER_NETWORKS=eth,solana,base,bsc
WALLET_TRACKER_POOLS_PER_NETWORK=4
WALLET_TRACKER_MIN_TRADE_USD=10000
WALLET_TRACKER_MIN_NET_USD=150000
WALLET_TRACKER_AUTO_TRACK_NET_USD=500000
WALLET_TRACKER_AUTO_INACTIVE_DAYS=7
WALLET_TRACKER_POLL_INTERVAL_SECONDS=300
WALLET_TRACKER_RETENTION_DAYS=8
WALLET_TRACKER_API_DELAY_SECONDS=4.0
# Alert noise controls; terminal alert records are pruned, pending retries are preserved.
WALLET_TRACKER_ALERT_COOLDOWN_MINUTES=10
WALLET_TRACKER_ALERT_RETENTION_DAYS=30

# ---- MySQL ----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=your_user
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=crypto_signals

# ---- Binance ----
# Public market data endpoints do NOT require API keys.
# Only add keys later if you place orders / need higher rate limits.
BINANCE_API_KEY=your_api_key

# ---- Telegram (used in a later step, keep here for convenience) ----
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Set true only after confirming futures WS (fstream.binance.com) is
# reachable from your network -- some regions restrict Binance Futures.
ENABLE_FUTURES=True

# ---- Collector tuning ----
OI_POLL_INTERVAL_SECONDS=60
FUNDING_WRITE_INTERVAL_SECONDS=60

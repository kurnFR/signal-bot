# ---- Deployment mode (Docker Compose only; ignored for local runs) ----
# 'bundled-db' starts the MariaDB container in docker-compose.yml.
# .env copied from this file keeps the bundled database as the default.
# EXTERNAL MySQL/MariaDB (e.g. already running on this server): remove
# 'bundled-db' from COMPOSE_PROFILES, and set MYSQL_HOST and
# FUNDING_DB_HOST below to host.docker.internal (host server) or to the
# external server's hostname/IP. The DB user must be allowed to connect
# from the Docker network (not only from 'localhost').
COMPOSE_PROFILES=bundled-db

# ---- MySQL ----
# Local (non-Docker) runs: 127.0.0.1. Docker Compose reads this value too:
# use 'mariadb' for the bundled database, 'host.docker.internal' for a
# database running on the Docker host itself.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=your_user
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=crypto_signals
# All signal-bot components, including RetailBot v2, use MYSQL_DATABASE.

# ---- Web server ----
# Bind address. Default 127.0.0.1 (local only). Use 0.0.0.0 ONLY behind a firewall /
# TLS reverse proxy; the dashboard has no TLS of its own.
SIGNAL_BOT_HOST=127.0.0.1
WEB_PORT=8050
# Supervisor startup controls. Safe defaults match the Phase 2A process set.
# run_all.py does not apply migrations unless explicitly authorized below.
SIGNAL_BOT_AUTO_MIGRATE=0
# Explicit override: 1/true/yes always skips startup migrations.
SKIP_DB_MIGRATE=0

# Optional processes are excluded unless individually enabled.
PAPER_ENGINE_ENABLED=0
NEWS_AI_ENABLED=0
# RetailBot2 supervisor opt-in and independent trading authorization.
RETAILBOT2_ENABLED=0
RETAILBOT2_ALLOW_TRADING=0
# RetailBot2 outbox and Telegram delivery require separate explicit authorization;
# see README.md and docs/SECURITY.md before enabling either.

# ---- Backtest and shared accounting cost assumptions ----
# Decimal fractions PER SIDE: 0.001 = 0.1%; 0.0005 = 0.05%.
# Defaults are illustrative; set fee to match your venue/order type and
# slippage conservatively. These are fixed rates, not a spread/liquidity model.
BACKTEST_FEE_PCT=0.001
BACKTEST_SLIPPAGE_PCT=0.0005

# ---- Paper trading risk limits ----
PAPER_MAX_CONCURRENT_POSITIONS=5
PAPER_MAX_DAILY_LOSS_USD=500
# Total notional of all OPEN paper positions may not exceed this (USD).
PAPER_MAX_TOTAL_NOTIONAL_USD=25000

# ---- Binance ----
# Public market data endpoints do NOT require API keys.
# No Binance API key is used anywhere in the codebase: market data is
# public and execution is paper-only, so there is no key to configure.

# ---- Telegram (used in a later step, keep here for convenience) ----
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Set true only after confirming futures WS (fstream.binance.com) is
# reachable from your network -- some regions restrict Binance Futures.
ENABLE_FUTURES=False

# ---- Collector tuning ----
OI_POLL_INTERVAL_SECONDS=60
FUNDING_WRITE_INTERVAL_SECONDS=60

# ---- Funding collector dedicated DB credentials (Docker / funding_poller) ----
# collectors/funding_poller.py is fail-closed: it requires its OWN MariaDB
# user/password and refuses MYSQL_* fallbacks and the users 'cms'/'root'.
# Provision a dedicated user with read/write access to MYSQL_DATABASE, e.g.:
#   CREATE USER 'signal_funding_collector'@'%' IDENTIFIED BY '<STRONG_RANDOM_PASSWORD>';
#   GRANT SELECT, INSERT, UPDATE, DELETE ON crypto_signals.* TO 'signal_funding_collector'@'%';
# docker-compose.yml passes these to the funding-collector service; without
# them that service cannot start and no funding-rate data is collected.
# For Docker with an external database, set FUNDING_DB_HOST to the
# same host as MYSQL_HOST (e.g. host.docker.internal); the local default
# is 127.0.0.1 and the Compose default is the bundled 'mariadb' service.
FUNDING_DB_HOST=
FUNDING_DB_USER=signal_funding_collector
FUNDING_DB_PASSWORD=<redacted>
# TELEGRAM_DELIVERY_ENABLED (master switch; deprecated alias
# RETAILBOT2_ALLOW_TELEGRAM_DELIVERY) gates Telegram delivery across the
# notifier, wallet tracker, screener, report scheduler, and outbox worker
# (docker compose --profile outbox). Keep 0 unless you have reviewed
# docs/SECURITY.md and intend to send real Telegram alerts.
TELEGRAM_DELIVERY_ENABLED=0
RETAILBOT2_ALLOW_TELEGRAM_DELIVERY=0

# ---- News + Economic Calendar (News AI Overlay strategy, Phase 1) ----
# CryptoPanic: crypto-specific news/sentiment. Free tier available:
#   https://cryptopanic.com/developers/api/
CRYPTOPANIC_API_KEY=your_cryptopanic_token
# Finnhub: macro economic calendar (CPI, FOMC, NFP, etc). Free tier available:
#   https://finnhub.io/register
FINNHUB_API_KEY=your_finnhub_key
NEWS_POLL_INTERVAL_SECONDS=120
ECON_CALENDAR_POLL_INTERVAL_SECONDS=3600
ECON_CALENDAR_MIN_IMPACT=medium

# ---- AI reasoning layer (News AI Overlay strategy, Phase 2) ----
# Anthropic API key -- https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-sonnet-5
# Provider selection: config.py defaults LLM_PROVIDER to '9router' (a local
# gateway), NOT to Anthropic. Setting only ANTHROPIC_API_KEY above has no
# effect unless LLM_PROVIDER=anthropic is also set. Valid values:
# 9router | openrouter | anthropic
LLM_PROVIDER=anthropic
NINEROUTER_API_KEY=
NINEROUTER_BASE_URL=http://localhost:20128/v1
<redacted>
NINEROUTER_MODEL=cf/@cf/qwen/qwen2.5-coder-32b-instruct
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
<redacted>
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731:free
NEWS_AI_POLL_INTERVAL_SECONDS=300
NEWS_AI_MIN_CONFIDENCE=75
NEWS_AI_MAX_EVENTS_PER_SYMBOL=15

# ---- Execution (News AI Overlay strategy, Phase 3) ----
NEWS_AI_EXECUTION_POLL_INTERVAL_SECONDS=60

# ---- Paper trading engine (run_paper_engine.py) ----
# Max delay after a candle opens for a simulated next-open entry; later entries are skipped, not backfilled.
PAPER_ENTRY_MAX_DELAY_SECONDS=120
# Without this running, "Live Paper Trading" never evaluates on its own --
# it only ran on a manual "Evaluate Market Tick" click, on deploy, or
# after an ML run.
PAPER_ENGINE_POLL_INTERVAL_SECONDS=60
NEWS_AI_MAX_TRADES_PER_DAY=3
NEWS_AI_STOP_ATR_MULT=1.5


# ---- Smart Money Screener ----
# Universe: Binance spot pairs quoted in SYMBOLS_FILTER.
TIMEFRAME=1m
MIN_QUOTE_VOLUME_24H=1000000
# Optional CoinGecko market-cap floor. Set 0 to disable.
MIN_MARKET_CAP_USD=50000000
MARKET_CAP_PAGES=5
MARKET_CAP_REFRESH_MINUTES=30
# Quality gate: require at least two independent conditions.
REQUIRE_CONFLUENCE=true
MIN_SIGNAL_RVOL=5.0
MIN_SIGNAL_VELOCITY=3.0
MIN_QUALITY_SCORE=70
# HTF confirmation is evaluated only from already-closed 5m/15m candles.
HTF_TIMEFRAMES=5m,15m
HTF_EMA_FAST=9
HTF_EMA_SLOW=21
HTF_MIN_BARS=25
HTF_TIMEOUT_SEC=3
# A 1m anomaly cannot score 80+ unless HTF context is available.
MAX_QUALITY_WITHOUT_HTF=79
USE_TAKER_BUY_CONFIRMATION=true
RVOL_MULTIPLIER=7.0
VELOCITY_THRESHOLD=5.0
DIVERGENCE_MAX_PRICE_CHANGE=0.3
MAX_ALERTS_PER_HOUR=5
# Telegram delivery gate; MIN_QUALITY_SCORE above controls DB candidate detection only.
MIN_ALERT_QUALITY_SCORE=80
# Minimum quote volume in the signal candle (USDT). 0 disables this delivery filter.
MIN_ALERT_QUOTE_VOLUME=0
# Keep candidates fresh for up to 15 minutes while respecting the 5/hour delivery cap.
MAX_SIGNAL_AGE_SEC=900
# Weekly cleanup removes only EXPIRED rows older than this retention period.
EXPIRED_SIGNAL_RETENTION_DAYS=30
EXPIRED_SIGNAL_CLEANUP_INTERVAL_DAYS=7
MAX_ALERTS_PER_SYMBOL_PER_HOUR=1
ALERT_COOLDOWN_SEC=900

# --- Wallet Tracking (GeckoTerminal primary; optional Birdeye free-tier trade fallback) ---
# Optional: create a Birdeye Data Standard (free) API key to enable pair-trade fallback.
# Keep the account on the free plan; do not enable paid auto-renewal/overage.
BIRDEYE_API_KEY=
# Defaults below match config.py. If wallet_tracker_settings has a saved row,
# the dashboard's persisted MariaDB settings take precedence over these values.
WALLET_TRACKER_ENABLED=true
WALLET_TRACKER_NETWORKS=eth,solana,base,bsc
WALLET_TRACKER_POOLS_PER_NETWORK=4
WALLET_TRACKER_MIN_TRADE_USD=10000
WALLET_TRACKER_MIN_NET_USD=150000
WALLET_TRACKER_AUTO_TRACK_NET_USD=500000
WALLET_TRACKER_AUTO_INACTIVE_DAYS=7
WALLET_TRACKER_POLL_INTERVAL_SECONDS=300
WALLET_TRACKER_RETENTION_DAYS=8
WALLET_TRACKER_API_DELAY_SECONDS=4.0
# Alert noise controls; terminal alert records are pruned, pending retries are preserved.
WALLET_TRACKER_ALERT_COOLDOWN_MINUTES=10
WALLET_TRACKER_ALERT_RETENTION_DAYS=30

# ---- Production Security, Licensing & White-Label Branding ----
# Set SIGNAL_BOT_ENV=production for Docker / customer deployments.
SIGNAL_BOT_ENV=development
# Required in production (minimum 32 random hex characters: python3 -c "import secrets; print(secrets.token_hex(32))")
APP_SECRET_KEY=
MYSQL_ROOT_PASSWORD=
# Comma-separated allowed browser origins in production (e.g. https://desk.yourdomain.com)
SIGNAL_BOT_ALLOWED_ORIGINS=http://localhost:8050,http://127.0.0.1:8050
# Access token lifetime in seconds (defaults to 3600 in production, 86400 in dev)
ACCESS_TOKEN_EXPIRE_SECONDS=3600
# Signed SB1 commercial license key (mint via: python scripts/generate_license.py)
SIGNAL_BOT_LICENSE_KEY=
SIGNAL_BOT_LICENSE_SIGNING_KEY=
# White-label UI branding
SIGNAL_BOT_BRAND_NAME=Signal Bot
SIGNAL_BOT_LOGO_URL=

# Template unit: adjust User/Group, WorkingDirectory and the Python
# interpreter path to your deployment before installing.
[Unit]
Description=Signal Bot Binance Futures Funding Rate REST Collector (Dedicated Standalone Service)
Documentation=https://github.com/kurnFR/signal-bot
After=network-online.target mariadb.service
Wants=network-online.target mariadb.service

[Service]
Type=simple
User=signalbot
Group=signalbot
WorkingDirectory=/opt/signal-bot

# Dedicated least-privilege configuration file (0600 signalbot:signalbot)
# Strictly avoids loading main application .env to prevent cms credential exposure
EnvironmentFile=/etc/signal-bot/funding-collector.env
Environment=PYTHONUNBUFFERED=1

# Mandatory safety configuration: trading and notification delivery disabled
Environment=RETAILBOT2_ALLOW_TRADING=0
Environment=RETAILBOT2_ALLOW_TELEGRAM_DELIVERY=0
Environment=RETAILBOT2_ALLOW_DIRECT_TELEGRAM=0
Environment=RETAILBOT2_OUTBOX_WORKER_ENABLED=0

# Standalone entry point using dedicated polling loop
ExecStart=/usr/bin/python3 -m collectors.funding_poller

# Process lifecycle and recovery
Restart=always
RestartSec=10s
KillMode=control-group
KillSignal=SIGTERM
TimeoutStopSec=15s

# Journal logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=signal-funding-collector

# Security isolation
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=multi-user.target

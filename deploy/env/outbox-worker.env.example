# ═══════════════════════════════════════════════════════════════════════════════
# RetailBot2 Outbox Worker Environment Configuration Template
# ═══════════════════════════════════════════════════════════════════════════════
#
# Production environment file: /etc/retailbot2/outbox-worker.env
# Permissions: chmod 0600 /etc/retailbot2/outbox-worker.env
# Owner: chown retailbot:retailbot /etc/retailbot2/outbox-worker.env
#
# DO NOT COMMIT ACTUAL PASSWORDS OR TOKENS TO GIT.
#
# OBSERVATION & DEPLOYMENT CONTRACT (WO71795):
# 1. DISABLED BY DEFAULT: Copying this template as-is leaves observation and delivery
#    strictly disabled (0). The systemd service will refuse database access and fail
#    closed on startup until the system owner explicitly enables observation mode.
# 2. ENABLING OBSERVATION: To run in observation mode, set
#    RETAILBOT2_PRODUCTION_OUTBOX_OBSERVATION_ENABLED=1 and supply the dedicated
#    SELECT-only credentials (retailbot2_obs). Observation mode is strictly SELECT-only;
#    it does NOT claim queue items, modify rows, or authorize Telegram delivery.
# 3. ENABLING TELEGRAM DELIVERY: Telegram delivery requires a separate, explicit owner
#    authorization decision:
#    a. Set RETAILBOT2_ALLOW_TELEGRAM_DELIVERY=1 below.
#    b. Supply dispatcher credentials (retailbot2_dispatcher) and Telegram bot token/chat ID.
#    c. Remove the '--observation' argument from the systemd service ExecStart directive.
#    Never enable delivery authorization merely to satisfy health checks or observation.
# ═══════════════════════════════════════════════════════════════════════════════

# Database Connection Settings
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=crypto_signals

# ─────────────────────────────────────────────────────────────────────────────
# 1. Observation Mode (SELECT-Only Inspection)
# ─────────────────────────────────────────────────────────────────────────────
# Set to 1 ONLY when production observation is explicitly authorized by the owner.
# The packaged systemd service runs with --observation by default, but refuses
# database access until this flag is set to 1 with valid observation credentials.
# Observation is SELECT-only and NEVER claims rows or delivers Telegram alerts.
RETAILBOT2_PRODUCTION_OUTBOX_OBSERVATION_ENABLED=0
RETAILBOT2_PRODUCTION_OBSERVATION_DB_USER=retailbot2_obs
RETAILBOT2_PRODUCTION_OBSERVATION_DB_PASSWORD=your_observation_password_here

# ─────────────────────────────────────────────────────────────────────────────
# 2. Production Delivery Mode (Requires Separate Owner Authorization)
# ─────────────────────────────────────────────────────────────────────────────
# Set to 1 ONLY when live production Telegram delivery is explicitly approved.
# In addition to setting this flag, operators must remove --observation from
# the systemd unit ExecStart directive and provide delivery credentials below.
# NEVER enable delivery authorization merely to satisfy health checks or observation.
RETAILBOT2_ALLOW_TELEGRAM_DELIVERY=0
MYSQL_USER=retailbot2_dispatcher
MYSQL_PASSWORD=your_delivery_password_here

# Telegram Credentials (Required only for delivery mode)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

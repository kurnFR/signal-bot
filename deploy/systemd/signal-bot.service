# Template unit: adjust User/Group, WorkingDirectory and the Python
# interpreter path to your deployment before installing.
[Unit]
Description=Signal Bot Full Stack Supervisor (run_all.py)
Documentation=https://github.com/kurnFR/signal-bot/blob/master/docs/DEPLOYMENT_AND_ROLLBACK_RUNBOOK.md
After=network-online.target mariadb.service
Wants=network-online.target mariadb.service

[Service]
Type=simple
User=signalbot
Group=signalbot
WorkingDirectory=/opt/signal-bot

# Load configuration from production .env
EnvironmentFile=-/opt/signal-bot/.env
Environment=PYTHONUNBUFFERED=1
Environment="SIGNAL_BOT_USE_MODERN_UI=1"

# Process supervisor entry point (runs web, collectors, screener, wallet_tracker, paper_engine, outbox)
ExecStart=/usr/bin/python3 run_all.py

# Process lifecycle and recovery
Restart=always
RestartSec=5s
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30s

# Journal logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=signal-bot

# Security isolation
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

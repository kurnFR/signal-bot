# Template unit: adjust User/Group, WorkingDirectory and the Python
# interpreter path to your deployment before installing.
[Unit]
Description=Signal Bot Web Dashboard & REST API
Documentation=https://github.com/kurnFR/signal-bot
After=network-online.target mariadb.service
Wants=network-online.target mariadb.service

[Service]
Type=simple
User=signalbot
Group=signalbot
WorkingDirectory=/opt/signal-bot

# Load production parameters from environment file
EnvironmentFile=-/opt/signal-bot/.env
Environment=PYTHONUNBUFFERED=1

# Web server entry point (FastAPI / Uvicorn)
ExecStart=/usr/bin/python3 run_web.py --host 0.0.0.0 --port 8050

# Process lifecycle and recovery
Restart=always
RestartSec=5s
KillMode=control-group
KillSignal=SIGTERM
TimeoutStopSec=15s

# Journal logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=signal-web

# Security isolation
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
